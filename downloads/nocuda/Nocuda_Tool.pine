bool exportEnabled = input.bool(false, "Gerar código nos Pine Logs", group = G_TRANSFER, tooltip = "Script pessoal: emite uma vez por recálculo. Copie a mensagem NOCUDA integral e desative após copiar. Não escreve na área de transferência.", display = display.none) // NOCUDA_DEFAULT:exportEnabled
