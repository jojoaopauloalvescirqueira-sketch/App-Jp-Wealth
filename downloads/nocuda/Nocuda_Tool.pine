//@version=6
indicator("Nocuda Tool · 1.1", shorttitle = "Nocuda", overlay = true, max_lines_count = 400, max_labels_count = 400)

// CANDIDATO: compilação e interação no TradingView ainda não verificadas.
// Formato de intercâmbio NOCUDA v1 / geometria bars1. Apenas desenhos, sem ordens.
// Malha linear com passo FIXO de 0.125. Não usa os preços futuros.
// A e B pertencem ao nível +1 (linha 17); C pertence ao nível 0 (linha 9).
// As posições horizontais são resolvidas em candles, não em horas corridas.
// slot j: nível = -1 + j/8; número da linha = j+1 (a partir da principal).

const string G_TRANSFER = "00 · Transferir desenho"
const string G_ANCHORS = "01 · Pontos de controle"
const string G_RANGE = "02 · Alcance da malha"
const string G_GENERAL = "03 · Aparência geral"
const string G_L1 = "04 · Linha 1 | principal · nível -1"
const string G_L3 = "05 · Linha 3 | nível -0.75"
const string G_L5 = "06 · Linha 5 | nível -0.5"
const string G_L9 = "07 · Linha 9 | referência móvel · nível 0"
const string G_L17 = "08 · Linha 17 | referência de direção · nível 1"
const string G_INNER = "09 · Linhas intermediárias"
const string G_OUTER = "10 · Projeções externas"
const string G_LABELS = "11 · Numeração e rótulos"
const float LEVEL_STEP = 0.125
const int MAX_ANCHOR_AGE = 4999
const bool PRECONFIGURED = false // NOCUDA_PRECONFIGURED

// Desenhos por bar_index também consultam o histórico de time internamente.
// Reserva explícita para a primeira execução ocorrer com o mercado aberto.
max_bars_back(time, 5000)

