# Git metadata and local machine files
.git/
.DS_Store
.AppleDouble
.LSOverride
._*

# Operational backups, exports and private browser data
data/backups/*
!data/backups/.gitkeep
data/exports/
data/private/
**/*backup*.json
**/*export*.json
**/jpwealth_v9_state*.json
**/*credential*
**/*password*
# Exceção deliberada: teste PERMANENTE da política de segredo (fixture sintética,
# nunca credencial real) — o padrão acima protege arquivos de senha de verdade.
!tools/investor_password_test.py
**/*secret*
**/*token*
.env
.env.*
!.env.example

# Temporary files, logs and local reports
*.log
*.tmp
*.temp
*.swp
*.swo
*~
tmp/
temp/
scratch/
reports/tmp/
tools/.artifacts/
test-results/
playwright-report/
blob-report/
# Grafo de conhecimento gerado pelo graphify: artefato derivado e regeneravel,
# com cache local e caminho absoluto de maquina. Mesma politica de tools/.artifacts/.
graphify-out/

# Python caches and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dependency and coverage output
node_modules/
coverage/
npm-debug.log*

# Archive bundles are external handoff artifacts, not project history
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

