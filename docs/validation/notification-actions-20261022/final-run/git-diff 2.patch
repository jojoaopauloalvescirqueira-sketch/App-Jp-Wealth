+    current,past=page.evaluate("(() => {const d=new Date(),k=x=>x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0');return [k(d),k(new Date(d.getFullYear(),d.getMonth()-9,1))]})()")
