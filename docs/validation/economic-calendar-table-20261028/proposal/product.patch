+/* One semantic table; compact rows reflow without duplicating event nodes. */
+.calendar-economic-table{display:block;width:100%;border-collapse:collapse;font-size:12px;table-layout:fixed}
+.calendar-economic-caption{display:block;text-align:left;padding:0 0 8px;font-size:12px;font-weight:650;color:var(--ink-dim)}
+.calendar-economic-table thead{display:block;position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
+.calendar-economic-table tbody{display:block}
+.calendar-economic-table tr{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:8px;align-items:start;min-width:0}
+.calendar-economic-table th,.calendar-economic-table td{min-width:0;padding:0;text-align:left;overflow-wrap:anywhere}
+.calendar-economic-table .calendar-event-economic{padding:10px 0;border-top:1px solid var(--line)}
+.calendar-economic-time{grid-column:span 2;font-variant-numeric:tabular-nums;color:var(--ink-dim);padding-top:12px!important}
+.calendar-economic-currency{grid-column:span 2;font-weight:600;padding-top:12px!important}
+.calendar-economic-impact{grid-column:span 2;padding-top:11px!important}
+.calendar-economic-event{grid-column:span 6}
+.calendar-economic-title-line{display:flex;align-items:center;gap:4px;min-width:0;min-height:44px}
+.calendar-economic-title-line .calendar-event-title{flex:1;min-width:0;font-size:13px;line-height:1.45}
+.calendar-economic-title-line .calendar-icon-button{flex:0 0 44px;align-self:flex-start}
+.calendar-economic-event .calendar-event-warning{margin:2px 0 0;font-size:11px}
+.calendar-economic-table .calendar-economic-number{grid-column:span 4;text-align:right;font-variant-numeric:tabular-nums;color:var(--ink)}
+.calendar-economic-value-label{display:block;color:var(--ink-dim);font-size:11px;margin-bottom:3px}
+.calendar-economic-value{display:block;font-size:13px;line-height:1.5;overflow-wrap:anywhere}
+.calendar-impact-symbol{display:inline-flex;align-items:flex-end;justify-content:center;gap:2px;width:24px;height:20px;color:var(--ink);font-weight:650}
+.calendar-impact-bar{display:block;width:4px;background:var(--ink-dim);opacity:.18;height:7px}.calendar-impact-bar:nth-child(2){height:12px}.calendar-impact-bar:nth-child(3){height:17px}.calendar-impact-filled{background:currentColor;opacity:1}
+.calendar-impact-high{color:var(--danger)}.calendar-impact-medium{color:var(--warn)}.calendar-impact-low{color:var(--violet)}
+.calendar-impact-unclassified{align-items:center;border:1px solid var(--ink-dim);border-radius:50%;width:20px;height:20px;font-size:12px}
+.calendar-economic-table .calendar-economic-detail-row{display:block}.calendar-economic-detail-row>td{display:block;width:100%}
+.calendar-economic-detail{padding:8px 12px 12px;background:var(--panel-2);border-radius:10px;margin:0 0 10px;font-size:12px;overflow-wrap:anywhere}
+.calendar-economic-detail .calendar-source-link{display:inline-flex;align-items:center;min-height:44px;margin-right:12px;max-width:100%}
+.calendar-economic-detail .calendar-meta{margin:4px 0}
+/* The body has 40px horizontal padding: 740px panel means 700px useful. */
+@container calendar-panel (min-width:740px){.calendar-body,#execEcal>.calendar-panel .calendar-body{grid-template-columns:308px minmax(0,1fr)}.calendar-agenda{padding-top:15px;border-top:0;max-height:470px;overflow-y:auto;overflow-x:hidden}}
+@container calendar-economic (min-width:720px){
+.calendar-economic-table tr{grid-template-columns:64px 44px 52px minmax(0,1fr) repeat(3,minmax(70px,.55fr));gap:8px}
+.calendar-economic-table thead{position:static;width:100%;height:auto;overflow:visible;clip-path:none;white-space:normal;padding-bottom:8px;color:var(--ink-dim);font-size:11px;font-weight:600}
+.calendar-economic-table .calendar-event-economic>td{grid-column:auto}
+.calendar-economic-time,.calendar-economic-currency,.calendar-economic-impact{padding-top:12px!important}
+.calendar-economic-number{padding-top:12px!important}
+.calendar-economic-value-label{display:none}
+.calendar-economic-table th:nth-child(n+5){text-align:right}
+}
+@media(max-width:360px){#execEcal>.calendar-panel{width:100vw;max-width:none;margin-left:calc((100% - 100vw)/2);border-left:0;border-right:0;border-radius:0}}
